# 复制为 .env 后填写；不要把真实值提交到仓库。

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 数据库
DB_NAME=jimeet
DB_USER=jimeet
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# 私有文件目录（留空则用 backend/var/private）
PRIVATE_FILE_ROOT=

# 业务开关
ALLOW_DEV_LOGIN=true
ALLOWED_EMAIL_DOMAINS=tongji.edu.cn
CSRF_TRUSTED_ORIGINS=
