# 复制为 .env 后填写；不要把真实值提交到仓库。

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 数据库
DB_NAME=jimeet
DB_USER=jimeet
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# 私有文件目录（留空则用 backend/var/private）
PRIVATE_FILE_ROOT=

# 业务开关
ALLOW_DEV_LOGIN=true
ALLOWED_EMAIL_DOMAINS=tongji.edu.cn
CSRF_TRUSTED_ORIGINS=

# 注册验证码（独立随机密钥至少 32 字符，SMTP 凭据仅配置在运行环境）
JIMEET_REGISTRATION_HMAC_KEY=
JIMEET_SMTP_HOST=smtp.tongji.edu.cn
JIMEET_SMTP_PORT=465
JIMEET_SMTP_USE_SSL=1
JIMEET_SMTP_USER=
JIMEET_SMTP_FROM=
JIMEET_SMTP_PASSWORD=
JIMEET_REGISTRATION_EMAIL_DAILY_LIMIT=10
JIMEET_REGISTRATION_IP_HOURLY_LIMIT=20
JIMEET_REGISTRATION_GLOBAL_DAILY_LIMIT=100
