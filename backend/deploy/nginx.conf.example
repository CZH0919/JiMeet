upstream jimeet_backend {
    server unix:/var/lib/jimeet/socket/web.sock;
}

server {
    listen 80;
    server_name jimeet.example.edu;
    return 308 https://jimeet.example.edu$request_uri;
}

server {
    listen 443 ssl;
    server_name jimeet.example.edu;

    ssl_certificate     /etc/jimeet/tls/fullchain.pem;
    ssl_certificate_key /etc/jimeet/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /srv/jimeet/frontend;
    index index.html;

    location /api/v1/ {
        client_max_body_size 12m;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Protocol "";
        proxy_set_header X-Forwarded-Ssl "";
        proxy_pass http://jimeet_backend;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
